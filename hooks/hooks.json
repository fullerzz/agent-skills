{
  "description": "Orient sessions, restore explicitly enabled z-mode, and optionally record xray metadata.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-config",
              "python",
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py",
              "--host=claude"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-config",
              "python",
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/hooks/xray.py",
              "--host=claude"
            ],
            "async": true
          }
        ],
        "matcher": ".*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-config",
              "python",
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/hooks/xray.py",
              "--host=claude"
            ],
            "async": true
          }
        ],
        "matcher": ".*"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-config",
              "python",
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/hooks/xray.py",
              "--host=claude"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-config",
              "python",
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/hooks/xray.py",
              "--host=claude"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-config",
              "python",
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/hooks/xray.py",
              "--host=claude"
            ]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-config",
              "python",
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/hooks/xray.py",
              "--host=claude"
            ]
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-config",
              "python",
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/hooks/xray.py",
              "--host=claude"
            ]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-config",
              "python",
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/hooks/xray.py",
              "--host=claude"
            ],
            "async": true
          }
        ],
        "matcher": ".*"
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-config",
              "python",
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/hooks/xray.py",
              "--host=claude"
            ]
          }
        ]
      }
    ]
  }
}
