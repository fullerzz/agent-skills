{
  "description": "Orient each session and restore explicitly enabled z-mode.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "--no-config", "python", "-I", "-S", "${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py", "--host=claude"]
          }
        ]
      }
    ]
  }
}
