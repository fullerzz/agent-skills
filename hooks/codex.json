{
  "description": "Orient sessions, restore explicitly enabled z-mode, and optionally record xray metadata.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-config python -I -S \"${PLUGIN_ROOT}/hooks/session_start.py\" --host=codex",
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-config python -I -S \"${PLUGIN_ROOT}/hooks/xray.py\" --host=codex"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-config python -I -S \"${PLUGIN_ROOT}/hooks/xray.py\" --host=codex"
          }
        ],
        "matcher": ".*"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-config python -I -S \"${PLUGIN_ROOT}/hooks/xray.py\" --host=codex"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-config python -I -S \"${PLUGIN_ROOT}/hooks/xray.py\" --host=codex"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-config python -I -S \"${PLUGIN_ROOT}/hooks/xray.py\" --host=codex"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-config python -I -S \"${PLUGIN_ROOT}/hooks/xray.py\" --host=codex"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-config python -I -S \"${PLUGIN_ROOT}/hooks/xray.py\" --host=codex"
          }
        ]
      }
    ]
  }
}
